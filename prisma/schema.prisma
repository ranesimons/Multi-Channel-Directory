// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  EMAIL
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  SMS
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum Stage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum OfferStatus {
  OPEN
  NEGOTIATING
  WON
  LOST
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String?
  stage     Stage    @default(NEW)
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email            String?
  phone            String?
  facebookHandle   String?
  instagramHandle  String?
  whatsappNumber   String?

  messages Message[]
  notes    Note[]
  tags     TagsOnLeads[]
  offers   OffersOnLeads[]
}

model Message {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel   Channel
  direction Direction
  body      String
  sentAt    DateTime  @default(now())
  read      Boolean   @default(true)

  @@index([leadId, sentAt])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Tag {
  id    String        @id @default(cuid())
  name  String        @unique
  color String        @default("gray")
  leads TagsOnLeads[]
}

model TagsOnLeads {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Offer {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      OfferStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  leads OffersOnLeads[]
}

model OffersOnLeads {
  offerId  String
  leadId   String
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@id([offerId, leadId])
}
